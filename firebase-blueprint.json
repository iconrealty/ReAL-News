        "clicks": { "type": "number" },
        "createdAtMs": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "advertiserName", "title", "placement", "status"]
    },
    "settings": {
      "title": "Application Global Settings",
      "description": "Global application configuration including monetization status",
