        "readTime": { "type": "string" },
        "heroImage": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "sourceCitation": { "type": "string" },
        "isBreaking": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "keyTakeaways": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "string" }
